# =============================================================================
# tr-stack — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# IP to bind external ports (default: all interfaces)
# BIND_IP=192.168.1.100

# tr-engine ports
HTTP_PORT=80

# PostgreSQL credentials
POSTGRES_USER=trengine
POSTGRES_PASSWORD=MMvaNzAcoAo84y3Cpo9wHw==
POSTGRES_DB=trengine

# API tokens — generate with: openssl rand -base64 32
AUTH_TOKEN=xZVjwKiQqW8HlZJMsd+4/Sy+uEcqfdLRA7wkpxuQu14
WRITE_TOKEN=CEWFZ+OWvx+jLGJDd7aJYJnLpdrXEqZGILKrfRYABUE

# MQTT topics — must match your trunk-recorder plugin config
MQTT_TOPICS=tr/#

# Transcription provider
STT_PROVIDER=imbe
IMBE_ASR_URL=http://imbe-asr:8000

# IMBE-ASR model tuning (P25 fine-tuned defaults)
# Use alpha=0.7 beta=2.0 for the large-1024d model on clean speech
IMBE_ASR_BEAM_WIDTH=100
IMBE_ASR_DEVICE=cuda

# Optional: point at trunk-recorder's audio dir for file-based ingest
# TR_AUDIO_DIR=/app/audio
SITE_ADDRESS=http://10.2.2.133
AUTH_ENABLED=false
IMBE_ASR_MODEL=trunk-reporter/imbe-asr-base-512d-p25
